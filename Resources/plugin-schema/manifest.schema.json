{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TurnOver plugin manifest",
  "description": "Who made the plugin and which applications it is for (PLUGIN-GUIDE.md).",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "apps"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]+$",
      "description": "One word: letters, digits and hyphens. The same id replaces."
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "apps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Bundle identifiers; nothing applies anywhere else."
    },
    "kind": {
      "const": "profile"
    },
    "formatVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "minimumTurnOver": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)*$"
    },
    "summary": {
      "type": "string",
      "maxLength": 120,
      "description": "One line, spoken at install and in the library."
    },
    "contact": {
      "type": "string",
      "description": "An email address or web page for problems."
    },
    "changes": {
      "type": "array",
      "description": "What changed in each version, newest first.",
      "items": {
        "type": "object",
        "required": [
          "version",
          "notes"
        ],
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "abilities": {
      "type": "array",
      "description": "What it asks to do, in TurnOver's fixed words.",
      "items": {
        "enum": [
          "read",
          "press",
          "focus",
          "menu",
          "keys",
          "say"
        ]
      }
    },
    "privacy": {
      "type": "string",
      "description": "What it reads and where anything goes."
    },
    "license": {
      "enum": [
        "MIT",
        "Apache-2.0",
        "BSD-2-Clause",
        "BSD-3-Clause",
        "ISC",
        "MPL-2.0",
        "CC0-1.0",
        "Unlicense"
      ],
      "description": "An open licence (SPDX name); the library's own is MIT."
    }
  }
}
